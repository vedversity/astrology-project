# Copy this file to ".env.local" and change the values for the live site.
# These three are not secrets: they are visible to anyone using the website.

# Where the backend API runs
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# The public address of this website (used in search-engine tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# Visitor counting with Google Analytics 4 (optional). Leave empty to send nothing.
# Before switching it on, mention analytics in the privacy policy.
NEXT_PUBLIC_GA_ID=
