# Backend settings. Copy this file to  backend/.env  and fill in real values there.
# The real .env file is never committed to Git. On a live server, set these in
# the host's dashboard instead of a file.
#
# The astro engine, the PDFs and the website need NO keys at all to run.

# Password for the owner's settings page (website address: /admin).
# Use 12 or more characters. Leave empty to keep the admin page switched off.
ADMIN_TOKEN=

# The website's address(es), comma-separated, so its pages may call this API.
# For local use the default (http://localhost:3000) already works.
# FRONTEND_ORIGINS=https://your-site.example,https://www.your-site.example

# Set to "production" on the live server: switches off the /docs pages.
# ENV=production

# ---- Payments (Razorpay) ----
# Leave empty and the site runs in TEST mode on your PC: orders are delivered
# without charging. Paste TEST keys (rzp_test_...) to try real checkout with
# Razorpay's test cards, and LIVE keys (rzp_live_...) to take real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook in the Razorpay dashboard.
# Webhook address:  https://<your-api-address>/webhooks/razorpay
# Events to tick:   payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=

# ---- Email delivery (any SMTP sender: Brevo, Resend, Gmail ...) ----
# Leave empty and no email is sent; the customer still gets the download page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# The website's address, used for the download link in the email.
# SITE_URL=https://your-site.example

# ---- Where orders are kept ----
# Default: backend/data/app.db (a single file). On a host, point this at a disk
# that survives restarts, e.g. /var/data/app.db
# DATABASE_PATH=

# The website has its own example file: frontend/.env.example
