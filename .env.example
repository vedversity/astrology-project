# Backend settings. Copy this file to  backend/.env  and fill in real values there.
# The real .env file is never committed to Git. On a live server, set these in
# the host's dashboard instead of a file.
#
# The astro engine, the PDFs and the website need NO keys at all to run.

# Password for the owner's settings page (website address: /admin).
# Use 12 or more characters. Leave empty to keep the admin page switched off.
ADMIN_TOKEN=

# The website's address(es), comma-separated, so its pages may call this API.
# For local use the default (http://localhost:3000) already works.
# FRONTEND_ORIGINS=https://your-site.example,https://www.your-site.example

# Set to "production" on the live server: switches off the /docs pages.
# ENV=production

# Phase 5 (payments and delivery) will add:
# DATABASE_URL=            (Supabase)
# RAZORPAY_KEY_ID=         (TEST mode keys first)
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# EMAIL_API_KEY=

# The website has its own example file: frontend/.env.example
