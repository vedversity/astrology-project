# Copy this file to ".env" and fill in real values there.
# The real .env file is never committed to Git.
#
# Phase 1 (astro engine) needs NO keys at all.
# Keys for later phases will be added here as each phase is built:
#
# DATABASE_URL=            (Phase 5 - Supabase)
# RAZORPAY_KEY_ID=         (Phase 5 - TEST mode keys first)
# RAZORPAY_KEY_SECRET=     (Phase 5)
# EMAIL_API_KEY=           (Phase 5)
#
# Phase 4 (website):
# FRONTEND_ORIGINS=https://your-site.example   (the website's address, so it may call the API)
# The website has its own example file: frontend/.env.example
